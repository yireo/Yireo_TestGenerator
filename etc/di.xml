<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Magento\Framework\Console\CommandList">
        <arguments>
            <argument name="commands" xsi:type="array">
                <item name="Yireo_TestGenerator::generate" xsi:type="object">Yireo\TestGenerator\Console\Command\GenerateCommand</item>
            </argument>
        </arguments>
    </type>

    <type name="Yireo\TestGenerator\Generator\UnitTestGenerator">
        <arguments>
            <argument name="testGenerators" xsi:type="array">
                <item name="openai" xsi:type="object">Yireo\TestGenerator\Generator\UnitTest\OpenAiTestGenerator</item>
            </argument>
        </arguments>
    </type>

    <type name="Yireo\TestGenerator\Generator\IntegrationTestGenerator">
        <arguments>
            <argument name="testGenerators" xsi:type="array">
                <item name="config" xsi:type="object">Yireo\TestGenerator\Generator\IntegrationTest\ConfigTestGenerator</item>
            </argument>
        </arguments>
    </type>
</config>
